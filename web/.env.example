# Strapi connection (build-time only — never shipped to the client).
# When STRAPI_API_URL is UNSET, the data layer falls back to local fixtures
# (src/data/__fixtures__) so `astro build` and tests run without a live Strapi.
# See src/lib/strapi.ts.

# Base URL of the Strapi instance, e.g. http://localhost:1337 or https://<project>.strapiapp.com
STRAPI_API_URL=

# Read-only API token issued by Strapi (feature 003 H4.1). Optional for public read.
STRAPI_API_TOKEN=

# Force fixtures even when STRAPI_API_URL is set (handy for offline dev/CI).
# USE_FIXTURES=true
