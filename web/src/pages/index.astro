---
/**
 * Home page (feature 002, FR-01). Ports the `data-page="home"` section of the
 * legacy `index.html`: a two-column "Who we are / What we do / Code of Conduct"
 * intro alongside the upcoming-event card.
 *
 * Per the Content & Rendering Map, the intro copy is CMS-driven (HomePage single
 * type) and the upcoming event comes from Strapi (EventBanner). The hero shell
 * itself is static (BaseLayout).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EventBanner from '../components/EventBanner.astro';
import LegacyHashRedirect from '../components/LegacyHashRedirect.astro';
import { getHomePage } from '../data/pages.js';
import { getUpcomingEvent } from '../data/events.js';

const home = await getHomePage();
const upcoming = await getUpcomingEvent();
---

<BaseLayout
  title="Brisbane Javascript"
  hero={true}
  heroTagline={home.heroTagline ?? 'The Brisbane Javascript meetup.'}
  path="/"
>
  <LegacyHashRedirect />
  <div class="ui vertical stripe segment">
    <div class="ui stackable grid container">
      <div class="row">
        <div class="eight wide column">
          <h3 class="ui header">Who we are</h3>
          {
            home.intro ? (
              <Fragment set:html={home.intro} />
            ) : (
              <p>
                We're the Brisbane JavaScript programming group - BrisJS for short. Our
                mission is to provide a community and a voice for Brisbane's JavaScript
                technology community.
              </p>
            )
          }
          <h3 class="ui header">What we do</h3>
          {
            home.whatWeDo ? (
              <Fragment set:html={home.whatWeDo} />
            ) : (
              <p>
                We present technical talks on the first Monday of every month, and have
                periodic networking events between.
              </p>
            )
          }
          <h3 class="ui header">Code of Conduct</h3>
          <p>
            BrisJS is dedicated to providing a harassment-free experience for everyone.
            Our anti-harassment policy can be found at our{' '}
            <a href="/code-of-conduct">Code of Conduct</a>.
          </p>
        </div>
        <div class="six wide right floated column">
          <EventBanner event={upcoming} />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
