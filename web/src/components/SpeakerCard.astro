---
/**
 * SpeakerCard — a speaker on the talk detail page (feature 002, FR-04).
 * Ports the per-speaker card in `templates/talk.hbs`:
 *  - photo when known, else a grey avatar placeholder (TC-03)
 *  - bio when known, else the legacy "no Twitter account yet" prompt
 *  - Twitter + Website links only when present
 *
 * The legacy site keyed everything off a Twitter cache (`twitter.profileImage`,
 * `twitter.description`, `twitter.username`, `twitter.url`). The CMS model now
 * stores these directly on the Speaker, so we map: photoUrl → image,
 * bio → description, twitter → Twitter handle, website → Website link.
 */
import type { SpeakerView } from '../data/types.js';

export interface Props {
  speaker: SpeakerView;
}

const { speaker } = Astro.props;
const twitterHandle = speaker.twitter?.replace(/^@/, '').replace(/^https?:\/\/(www\.)?twitter\.com\//, '') ?? null;
---

<div class="card">
  <div class="content">
    {
      speaker.photoUrl ? (
        <img class="right floated mini ui image" src={speaker.photoUrl} alt={speaker.name} />
      ) : (
        <span class="right floated ui avatar image" />
      )
    }
    <div class="header">
      <strong>{speaker.name}</strong>
    </div>
    <div class="description">
      {
        speaker.bio ? (
          <Fragment set:html={speaker.bio} />
        ) : (
          <Fragment>
            {speaker.name} does not have a bio (or we don't know it) yet.{' '}
            <a href="/contact">Contact us</a> to update this.
          </Fragment>
        )
      }
    </div>
  </div>
  {
    (twitterHandle || speaker.website) && (
      <div class="extra content">
        {twitterHandle && (
          <a title={`Twitter account for ${speaker.name}`} href={`https://twitter.com/${twitterHandle}`}>
            <span class="resource">
              <i class="twitter icon" /> Twitter
            </span>
          </a>
        )}
        {speaker.website && (
          <a title={`Website for ${speaker.name}`} href={speaker.website}>
            <span class="resource">
              <i class="linkify icon" /> Website
            </span>
          </a>
        )}
      </div>
    )
  }
</div>
