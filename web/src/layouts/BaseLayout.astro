---
/**
 * BaseLayout — the static shell for every page (feature 002, FR-05).
 *
 * Ports the legacy `index.html` chrome: the Semantic UI CDN stylesheet, the
 * inverted masthead/hero header with nav, and the inverted footer. Per the
 * Content & Rendering Map, the header/nav and footer are STATIC Astro (code,
 * not CMS); page content comes from the data layer.
 *
 * The legacy SPA used `#hash` routes inside one document; this port uses real
 * Astro routes, so nav links are real paths (e.g. /talks, /jobs). The hero is
 * only shown full-height on the home page (`hero` prop), matching the legacy
 * `body.home` gate in style.css.
 */
import '../styles/global.css';

export interface Props {
  /** <title> — page title. */
  title: string;
  /** Meta description + OG/Twitter description. */
  description?: string;
  /** Render the tall home hero (true only on the home page). */
  hero?: boolean;
  /** Hero tagline shown under the BrisJS H1 (home only). */
  heroTagline?: string;
  /** Canonical/OG path for this page, e.g. "/talks". */
  path?: string;
}

const {
  title,
  description = 'BrisJS — the Brisbane JavaScript meetup. Monthly talks, jobs, and community.',
  hero = false,
  heroTagline = 'The Brisbane Javascript meetup.',
  path = '/',
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://brisjs.org';
const canonical = `${site}${path}`;
const ogImage = `${site}/images/hero-1080.jpg`;

// Static nav model (code-owned per the Content & Rendering Map).
const nav = [
  { href: '/talk-requests', label: 'Present' },
  { href: '/talks', label: 'Past talks' },
  { href: '/jobs', label: 'Jobs' },
  { href: '/find-us', label: 'Find Us' },
];
const current = path;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Brisbane Javascript" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Semantic UI carried over from the legacy site, exactly as before (CDN) -->
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.2.10/semantic.min.css"
    />
  </head>
  <body class={hero ? 'home' : ''}>
    <div class="pusher">
      <div
        id="hero"
        class="ui inverted vertical masthead center aligned segment"
      >
        <div class="ui container">
          <div class="ui large secondary inverted pointing menu">
            <a class="item logo image" href="/"><img alt="BrisJS" src="/images/logo.svg" /></a>
            <a class={`item${current === '/' ? ' active' : ''}`} href="/">BrisJS</a>
            {
              nav.map((item) => (
                <a
                  class={`item${current === item.href ? ' active' : ''}`}
                  href={item.href}
                >
                  {item.label}
                </a>
              ))
            }
            <div class="right item">
              <a
                class="ui inverted button"
                href="https://www.meetup.com/en-AU/BrisJS/join/?rg=joinus2"
                >Join us!</a
              >
            </div>
          </div>
        </div>

        <div class="ui text container">
          <h1 class="ui inverted header">BrisJS</h1>
          <h2>{heroTagline}</h2>
          <a class="ui huge primary button" href="https://www.meetup.com/BrisJS/">
            Next Event
            <i class="right arrow icon"></i>
          </a>
        </div>
      </div>

      <main>
        <slot />
      </main>

      <div class="ui inverted vertical footer segment">
        <div class="ui container">
          <div class="ui stackable inverted divided equal height stackable grid">
            <div class="three wide column">
              <h4 class="ui inverted header">About</h4>
              <div class="ui inverted link list">
                <a class="item" href="/">BrisJS</a>
                <a class="item" href="/talk-requests">Present a talk</a>
                <a class="item" href="/talks">Past talks</a>
                <a class="item" href="/jobs">Find a job</a>
                <a class="item" href="/find-us">Find us</a>
                <a class="item" href="/contact">Contact</a>
                <a class="item" href="/code-of-conduct">Code of Conduct</a>
              </div>
            </div>
            <div class="three wide column">
              <h4 class="ui inverted header">Follow us elsewhere</h4>
              <div class="ui inverted link list">
                <a href="https://meetup.com/BrisJS/" class="item">Meetup</a>
                <a href="https://github.com/BrisJS/meetups/issues" class="item">GitHub Issues</a>
                <a href="https://twitter.com/brisjs" class="item">Twitter</a>
                <a href="https://www.facebook.com/BrisJSMeetup/" class="item">Facebook</a>
                <a href="https://bne.social/@brisjs" class="item">Mastodon</a>
              </div>
            </div>
            <div class="seven wide column">
              <h4 class="ui inverted header">Brisbane Javascript</h4>
              <p>
                BrisJS is brought to you by our sponsors. This site built with
                <a href="https://semantic-ui.com">Semantic UI</a>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
