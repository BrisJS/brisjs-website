{
  "kind": "collectionType",
  "collectionName": "job_postings",
  "info": {
    "singularName": "job-posting",
    "pluralName": "job-postings",
    "displayName": "Job Posting",
    "description": "A job/employment posting (replaces label-filtered GitHub issues)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "submittedDate": {
      "type": "date"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "open",
        "filled",
        "closed"
      ],
      "default": "open"
    }
  }
}
