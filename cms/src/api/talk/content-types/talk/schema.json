{
  "kind": "collectionType",
  "collectionName": "talks",
  "info": {
    "singularName": "talk",
    "pluralName": "talks",
    "displayName": "Talk",
    "description": "A talk given at a BrisJS meetup."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "legacyId": {
      "type": "integer",
      "unique": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "synopsis": {
      "type": "richtext"
    },
    "youtubeUrl": {
      "type": "string"
    },
    "slidesUrl": {
      "type": "string"
    },
    "codeUrl": {
      "type": "string"
    },
    "speakers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::speaker.speaker",
      "inversedBy": "talks"
    },
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event",
      "inversedBy": "talks"
    }
  }
}
