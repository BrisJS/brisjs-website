{
  "kind": "collectionType",
  "collectionName": "organizers",
  "info": {
    "singularName": "organizer",
    "pluralName": "organizers",
    "displayName": "Organizer",
    "description": "A BrisJS organizer shown on the contact list (replaces data/contact.json)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string"
    },
    "bio": {
      "type": "richtext"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "twitter": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "order": {
      "type": "integer"
    }
  }
}
